# Normalise line endings so a Windows checkout does not commit CRLF into the repo.
* text=auto eol=lf

# Keep binary assets binary.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary

# Lockfiles and generated CSS are noisy in diffs and pollute language stats.
package-lock.json -diff linguist-generated
